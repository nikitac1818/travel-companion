# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase project settings (Project Settings -> API in your Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# URL of your deployed backend (Express server). Use http://localhost:4000 for local dev.
VITE_BACKEND_URL=http://localhost:4000
